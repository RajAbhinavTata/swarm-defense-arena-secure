# Swarm Defense Arena secrets and LLM defaults
# Fill these with your real keys before running LLM-powered modes.

OPENAI_API_KEY=sk-openai-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional provider/model defaults (for upcoming per-side LLM routing)
ARENA_TASK_AGENT_PROVIDER=openai
ARENA_TASK_AGENT_MODEL=gpt-5-mini
ARENA_RED_TEAM_PROVIDER=anthropic
ARENA_RED_TEAM_MODEL=claude-sonnet-4-6

# Optional sampling controls
ARENA_TASK_AGENT_TEMPERATURE=0.3
ARENA_RED_TEAM_TEMPERATURE=0.7

# Security controls. Private/link-local targets are blocked by default.
ARENA_ALLOW_PRIVATE_TARGETS=false
ARENA_MAX_CONCURRENT_RUNS=2
ARENA_MAX_RUNS_PER_MINUTE=6

# Required for API access when the app is not served from localhost.
# Put authentication in a reverse proxy for browser access in shared deployments.
ARENA_API_TOKEN=replace-with-a-long-random-value

# Optional operational limits.
ARENA_NAVIGATION_TIMEOUT_MS=30000
ARENA_LLM_TIMEOUT_MS=12000
ARENA_MAX_SESSION_AGE_DAYS=30
