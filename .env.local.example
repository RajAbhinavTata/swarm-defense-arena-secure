# Sentinel Arena secrets and LLM defaults
# Fill these with your real keys before running LLM-powered modes.

OPENAI_API_KEY=sk-openai-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional provider/model defaults (for upcoming per-side LLM routing)
SENTINEL_TASK_AGENT_PROVIDER=openai
SENTINEL_TASK_AGENT_MODEL=gpt-5-mini
SENTINEL_RED_TEAM_PROVIDER=anthropic
SENTINEL_RED_TEAM_MODEL=claude-sonnet-4-6

# Optional sampling controls
SENTINEL_TASK_AGENT_TEMPERATURE=0.3
SENTINEL_RED_TEAM_TEMPERATURE=0.7

# Security controls. Private/link-local targets are blocked by default.
SENTINEL_ALLOW_PRIVATE_TARGETS=false
SENTINEL_MAX_CONCURRENT_RUNS=2
SENTINEL_MAX_RUNS_PER_MINUTE=6

# Required for API access when the app is not served from localhost.
# Put authentication in a reverse proxy for browser access in shared deployments.
SENTINEL_API_TOKEN=replace-with-a-long-random-value

# Optional operational limits.
SENTINEL_NAVIGATION_TIMEOUT_MS=30000
SENTINEL_LLM_TIMEOUT_MS=12000
SENTINEL_MAX_SESSION_AGE_DAYS=30
